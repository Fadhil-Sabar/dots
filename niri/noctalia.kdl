layout {

    focus-ring {
        active-color   "#ffafd5"
        inactive-color "#171214"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffafd5"
        inactive-color "#171214"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffafd5"
        inactive-color "#782956"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffafd580"
    }
}

recent-windows {
    highlight {
        active-color "#ffafd5"
        urgent-color "#ffb4ab"
    }
}
